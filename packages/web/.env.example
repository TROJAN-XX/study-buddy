# ==============================================================================
# Study Buddy Web PWA Environment Variables (.env.example)
# ==============================================================================
# Vite automatically exposes variables prefixed with `VITE_` to client code.
#
# USAGE:
#   Copy this file to `.env.local` for local development:
#   cp packages/web/.env.example packages/web/.env.local
#
# NOTE:
#   If VITE_API_URL is omitted or unreachable, Study Buddy automatically
#   falls back to fully standalone, offline-first IndexedDB storage and
#   queues mutations until a Worker becomes available.
# ==============================================================================

# Edge API Base URL
# Local development: http://localhost:8787
# Cloudflare production: https://study-buddy-api.<your-subdomain>.workers.dev
VITE_API_URL=http://localhost:8787

# Authentication Token (must match API_TOKEN on Cloudflare Worker)
VITE_API_TOKEN=study-buddy-dev-token-change-in-production
