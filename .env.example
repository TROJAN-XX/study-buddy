# ==============================================================================
# Study Buddy — Root Environment Variables Template (.env.example)
# ==============================================================================
# This file serves as the master documentation for environment variables across
# the entire Study Buddy monorepo.
#
# DO NOT COMMIT SECRETS TO SOURCE CONTROL.
# For local development:
#   1. For the Edge API Worker: configure packages/api/.dev.vars
#   2. For the Web PWA: copy packages/web/.env.example to packages/web/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Workers API (packages/api)
# ------------------------------------------------------------------------------
# Secret token required to authenticate requests via `Authorization: Bearer <token>`.
# In local dev: Place this in packages/api/.dev.vars
# In production: Set via `npx wrangler secret put API_TOKEN`
API_TOKEN=study-buddy-super-secret-token-change-in-production

# Cloudflare D1 Database Binding Name (matches wrangler.toml)
D1_DATABASE_NAME=study-buddy-db

# ------------------------------------------------------------------------------
# 2. Web Progressive Web App (packages/web)
# ------------------------------------------------------------------------------
# Base URL of the API Worker.
# Leave empty or unset to run purely in offline-first LocalStorage mode.
# Local Worker: http://localhost:8787
# Production Worker: https://study-buddy-api.<your-subdomain>.workers.dev
VITE_API_URL=http://localhost:8787

# Bearer Token passed in Authorization header from the web client
# Must match API_TOKEN configured on the Worker
VITE_API_TOKEN=study-buddy-super-secret-token-change-in-production
